{%- liquid
  assign desktop_align = section.settings.desktop_content_alignment
-%}

<section
  class="gg-hero"
  id="GiftGuideHero-{{ section.id }}"
  style="--gg-hero-min-height-mobile: {{ section.settings.mobile_min_height }}px; --gg-hero-min-height-desktop: {{ section.settings.desktop_min_height }}px;"
>
  <div class="gg-hero__header" id="gg-hero-header-{{ section.id }}">
    <div class="gg-hero__topbar">
      <button
        type="button"
        class="gg-hero__menu-toggle"
        data-menu-toggle
        aria-expanded="false"
        aria-controls="gg-hero-mobile-menu-{{ section.id }}"
      >
        <span class="gg-hero__menu-toggle-label visually-hidden">Menu</span>
        <span class="gg-hero__menu-icon gg-hero__menu-icon--open" aria-hidden="true">
          <span></span>
          <span></span>
          <span></span>
        </span>
        <span class="gg-hero__menu-icon gg-hero__menu-icon--close" aria-hidden="true">×</span>
      </button>

      {%- if section.settings.header_logo_text != blank -%}
        <div class="gg-hero__topbar-logo">
          {%- if section.settings.header_logo_link != blank -%}
            <a href="{{ section.settings.header_logo_link }}" class="gg-hero__topbar-logo-link">
              <span class="gg-hero__topbar-logo-text">{{ section.settings.header_logo_text | escape }}</span>
            </a>
          {%- else -%}
            <span class="gg-hero__topbar-logo-text">{{ section.settings.header_logo_text | escape }}</span>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if section.settings.header_tagline != blank -%}
        <p class="gg-hero__topbar-tagline gg-hero__topbar-tagline--desktop">{{ section.settings.header_tagline | escape }}</p>
      {%- endif -%}

      {%- if section.settings.header_button_label != blank -%}
        <a
          class="gg-hero__topbar-button gg-hero__topbar-button--desktop"
          {% if section.settings.header_button_link != blank %}
            href="{{ section.settings.header_button_link }}"
          {% else %}
            role="link"
            aria-disabled="true"
          {% endif %}
          {% if section.settings.header_button_open_new_tab %}
            target="_blank"
            rel="noopener noreferrer"
          {% endif %}
        >
          <span class="gg-hero__topbar-button-label">{{ section.settings.header_button_label | escape }}</span>
          <span class="gg-hero__topbar-button-arrow" aria-hidden="true">→</span>
        </a>
      {%- endif -%}
    </div>

    <div
      class="gg-hero__mobile-menu"
      id="gg-hero-mobile-menu-{{ section.id }}"
      data-mobile-menu
      hidden
    >
      {%- if section.settings.header_tagline != blank -%}
        <p class="gg-hero__mobile-menu-tagline">{{ section.settings.header_tagline | escape }}</p>
      {%- endif -%}

      {%- if section.settings.header_button_label != blank -%}
        <a
          class="gg-hero__topbar-button gg-hero__topbar-button--mobile"
          {% if section.settings.header_button_link != blank %}
            href="{{ section.settings.header_button_link }}"
          {% else %}
            role="link"
            aria-disabled="true"
          {% endif %}
          {% if section.settings.header_button_open_new_tab %}
            target="_blank"
            rel="noopener noreferrer"
          {% endif %}
        >
          <span class="gg-hero__topbar-button-label">{{ section.settings.header_button_label | escape }}</span>
          <span class="gg-hero__topbar-button-arrow" aria-hidden="true">→</span>
        </a>
      {%- endif -%}
    </div>
  </div>

  <div class="gg-hero__main">
    <div class="gg-hero__media" aria-hidden="true">
      <div class="gg-hero__image gg-hero__image--mobile">
        {%- if section.settings.image_mobile != blank -%}
          {{
            section.settings.image_mobile
            | image_url: width: 1200
            | image_tag:
              class: 'gg-hero__img',
              widths: '375, 550, 750, 1100, 1200',
              sizes: '100vw',
              loading: 'eager',
              fetchpriority: 'high',
              alt: ''
          }}
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'gg-hero__placeholder' }}
        {%- endif -%}
      </div>

      <div class="gg-hero__image gg-hero__image--desktop">
        {%- if section.settings.image_desktop != blank -%}
          {{
            section.settings.image_desktop
            | image_url: width: 2400
            | image_tag:
              class: 'gg-hero__img',
              widths: '750, 1100, 1500, 1780, 2000, 2400',
              sizes: '100vw',
              loading: 'eager',
              fetchpriority: 'high',
              alt: ''
          }}
        {%- else -%}
          {{ 'lifestyle-2' | placeholder_svg_tag: 'gg-hero__placeholder' }}
        {%- endif -%}
      </div>
    </div>

    <div class="gg-hero__overlay">
      <div class="gg-hero__content gg-hero__content--desktop-{{ desktop_align }}">
        <div class="gg-hero__content-copy">
          {%- if section.settings.heading != blank -%}
            <h2 class="gg-hero__heading">{{ section.settings.heading | escape }}</h2>
          {%- endif -%}

          {%- if section.settings.description != blank -%}
            <p class="gg-hero__description">{{ section.settings.description | escape }}</p>
          {%- endif -%}
        </div>

        {%- if section.settings.button_label != blank -%}
          <a
            class="gg-hero__button"
            {% if section.settings.button_link != blank %}
              href="{{ section.settings.button_link }}"
            {% else %}
              role="link"
              aria-disabled="true"
            {% endif %}
            {% if section.settings.button_open_new_tab %}
              target="_blank"
              rel="noopener noreferrer"
            {% endif %}
          >
            <span class="gg-hero__button-label">{{ section.settings.button_label | escape }}</span>
            <span class="gg-hero__button-arrow" aria-hidden="true">→</span>
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>

  {%- if section.settings.banner_text != blank -%}
    <div class="gg-hero__banner">
      <p class="gg-hero__banner-text">{{ section.settings.banner_text | escape }}</p>
    </div>
  {%- endif -%}
</section>

{% stylesheet %}
  @import url('https://fonts.googleapis.com/css2?family=Jost:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap');

  .gg-hero {
    width: 100%;
    font-family: 'Jost', sans-serif;
    letter-spacing: 0;
  }

  .gg-hero .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .gg-hero__header {
    width: 100%;
  }

  .gg-hero__topbar {
    display: grid;
    grid-template-columns: 2.5rem 1fr 2.5rem;
    align-items: center;
    width: 100%;
    padding: 1rem .25rem;
    background: #f7f7f7;
    box-sizing: border-box;
  }

  .gg-hero__menu-toggle {
    grid-column: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    padding: 0;
    margin: 0;
    border: none;
    background: transparent;
    cursor: pointer;
    color: #000;
  }

  .gg-hero__menu-icon--open {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    width: 1.25rem;
    height: 0.875rem;
  }

  .gg-hero__menu-icon--open span {
    display: block;
    width: 100%;
    height: 1px;
    background: #000;
  }

  .gg-hero__menu-icon--close {
    display: none;
    font-size: 1.5rem;
    font-weight: 300;
    line-height: 1;
  }

  .gg-hero__header.is-menu-open .gg-hero__menu-icon--open {
    display: none;
  }

  .gg-hero__header.is-menu-open .gg-hero__menu-icon--close {
    display: block;
  }

  .gg-hero__header.is-menu-open .gg-hero__topbar {
    background: #fff;
    box-shadow: 0 2px 4px 0 rgba(0, 0, 0, 0.15);
    position: relative;
    z-index: 2;
  }

  .gg-hero__topbar-logo {
    grid-column: 2;
    justify-self: center;
  }

  .gg-hero__topbar-logo-link {
    text-decoration: none;
    color: inherit;
  }

  .gg-hero__topbar-logo-text {
    display: inline-block;
    font-size: 19px;
    font-weight: 600;
    text-transform: uppercase;
    color: #000;
    line-height: 1;
    white-space: nowrap;
  }

  .gg-hero__topbar-tagline--desktop {
    display: none;
    margin: 0;
    font-size: 16px;
    font-weight: 400;
    line-height: 13.424px;
    letter-spacing: 0;
    color: #000;
    text-align: center;
  }

  .gg-hero__topbar-button--desktop {
    display: none !important;
  }

  .gg-hero__mobile-menu {
    display: none;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
    width: 100%;
    padding: 1.5rem 1.25rem 2rem;
    background: #f7f7f7;
    box-sizing: border-box;
  }

  .gg-hero__header.is-menu-open .gg-hero__mobile-menu {
    display: flex;
  }

  .gg-hero__mobile-menu-tagline {
    margin: 0;
    width: 100%;
    max-width: 100%;
    font-size: 16px;
    font-weight: 400;
    line-height: 1.45;
    color: #000;
    text-align: center;
    white-space: nowrap;
  }

  .gg-hero__topbar-button {
    position: relative;
    display: none;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: 2.5rem;
    min-width: 10rem;
    padding: 0.625rem 1.5rem;
    background: #f4e04d;
    color: #000;
    text-decoration: none;
    font-size: 16px;
    font-weight: 600;
    text-transform: uppercase;
    border: none;
    cursor: pointer;
    overflow: hidden;
    isolation: isolate;
    transition: color 0.4s ease;
    white-space: nowrap;
  }

  .gg-hero__topbar-button::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    background: #000;
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 0.4s ease;
  }

  .gg-hero__topbar-button-label,
  .gg-hero__topbar-button-arrow {
    position: relative;
    z-index: 1;
    transition: color 0.4s ease;
  }

  .gg-hero__header.is-menu-open .gg-hero__topbar-button--mobile {
    display: inline-flex;
  }

  .gg-hero__topbar-button--mobile {
    width: 100%;
    max-width: 15.2rem;
  }

  .gg-hero__topbar-button:focus-visible::before {
    transform: scaleX(1);
  }

  .gg-hero__topbar-button:focus-visible {
    color: #fff;
  }

  @media (hover: hover) {
    .gg-hero__topbar-button:hover::before {
      transform: scaleX(1);
    }

    .gg-hero__topbar-button:hover {
      color: #fff;
    }
  }

  .gg-hero__topbar-button[aria-disabled='true'] {
    opacity: 0.6;
    pointer-events: none;
  }

  .gg-hero__topbar-button-arrow {
    font-size: 0.875rem;
    line-height: 1;
  }

  .gg-hero__main {
    position: relative;
    width: 100%;
    min-height: var(--gg-hero-min-height-mobile, 520px);
    overflow: hidden;
    background: #fff;
  }

  .gg-hero__media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .gg-hero__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .gg-hero__image--desktop {
    display: none;
  }

  .gg-hero__img,
  .gg-hero__placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .gg-hero__placeholder {
    background: #fff;
  }

  .gg-hero__overlay {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: stretch;
    justify-content: stretch;
    min-height: inherit;
    width: 100%;
    padding: 3.0625rem 1.25rem 2.5rem;
    box-sizing: border-box;
  }

  .gg-hero__content {
    width: 100%;
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: center;
    text-align: center;
    gap: 1.5rem;
    min-height: 100%;
  }

  .gg-hero__content-copy {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    width: 100%;
    max-width: 22rem;
    flex-shrink: 0;
  }

  .gg-hero__content .gg-hero__button {
    flex-shrink: 0;
    margin-top: auto;
  }

  .gg-hero__heading {
    margin: 0;
    font-size: 30px;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0;
    color: #000;
  }

  .gg-hero__description {
    margin: 0;
    font-size: 16px;
    font-weight: 400;
    line-height: 1.3;
    letter-spacing: 0;
    color: #000;
  }

  .gg-hero__button {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    min-height: 45px;
    padding: 13px 20px;
    background: #000;
    color: #fff;
    text-decoration: none;
    font-size: 16px;
    font-weight: 400;
    line-height: 1.28;
    letter-spacing: 0;
    text-transform: uppercase;
    border: none;
    cursor: pointer;
    overflow: hidden;
    isolation: isolate;
    transition: color 0.4s ease;
  }

  .gg-hero__button::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    background: #f4e04d;
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 0.4s ease;
  }

  .gg-hero__button-label,
  .gg-hero__button-arrow {
    position: relative;
    z-index: 1;
    transition: color 0.4s ease;
  }

  .gg-hero__button:focus-visible::before {
    transform: scaleX(1);
  }

  .gg-hero__button:focus-visible {
    color: #000;
  }

  @media (hover: hover) {
    .gg-hero__button:hover::before {
      transform: scaleX(1);
    }

    .gg-hero__button:hover {
      color: #000;
    }
  }

  .gg-hero__button[aria-disabled='true'] {
    opacity: 0.6;
    pointer-events: none;
  }

  .gg-hero__button-arrow {
    font-size: 1rem;
    line-height: 1;
  }

  .gg-hero__banner {
    width: 100%;
    background: #f5f5f5;
    padding: 0.875rem 1.25rem;
    box-sizing: border-box;
  }

  .gg-hero__banner-text {
    margin: 0;
    font-size: 14px;
    font-weight: 400;
    text-transform: uppercase;
    text-align: center;
    color: #000;
    line-height: 13.424px;
    letter-spacing: 0;
  }

  @media screen and (min-width: 750px) {
    .gg-hero__topbar {
      grid-template-columns: auto 1fr auto;
      grid-template-areas: 'logo tagline button';
      justify-items: stretch;
      gap: 1.5rem;
      padding: 10px 50px;
      background: #f7f7f7;
    }

    .gg-hero__menu-toggle {
      display: none;
    }

    .gg-hero__header.is-menu-open .gg-hero__topbar {
      background: #f7f7f7;
      box-shadow: none;
    }

    .gg-hero__topbar-logo {
      grid-column: auto;
      grid-area: logo;
      justify-self: start;
    }

    .gg-hero__banner{
      padding: 10px 50px;
    }

    .gg-hero__topbar-button {
      font-size: 1rem;
    }

    .gg-hero__topbar-tagline--desktop {
      display: block;
      grid-area: tagline;
      align-self: center;
      justify-self: center;
      max-width: 20rem;
    }

    .gg-hero__topbar-button--desktop {
      display: inline-flex !important;
      grid-area: button;
      justify-self: end;
      min-width: auto;
      width: 207px;
    }

    .gg-hero__mobile-menu {
      display: none !important;
    }

    .gg-hero__header.is-menu-open .gg-hero__mobile-menu {
      display: none !important;
    }

    .gg-hero__main {
      min-height: var(--gg-hero-min-height-desktop, 640px);
    }

    .gg-hero__image--mobile {
      display: none;
    }

    .gg-hero__image--desktop {
      display: block;
    }

    .gg-hero__overlay {
      align-items: flex-end;
      justify-content: flex-start;
      padding: 3rem clamp(2rem, 5vw, 4rem) 3.5rem;
    }

    .gg-hero__content {
      flex: none;
      min-height: auto;
      max-width: 32rem;
      justify-content: flex-start;
      align-items: flex-start;
      text-align: left;
      gap: 1.25rem;
    }

    .gg-hero__content-copy {
      display: contents;
    }

    .gg-hero__content .gg-hero__button {
      margin-top: 0;
      width: 100%;
        max-width: 220px;
    }

    .gg-hero__content--desktop-center {
      margin-inline: auto;
      align-items: center;
      text-align: center;
    }

    .gg-hero__content--desktop-right {
      margin-inline-start: auto;
      align-items: flex-end;
      text-align: right;
    }

    .gg-hero__overlay:has(.gg-hero__content--desktop-center) {
      justify-content: center;
    }

    .gg-hero__overlay:has(.gg-hero__content--desktop-right) {
      justify-content: flex-end;
    }

    .gg-hero__heading {
      font-size: 70px;
      font-weight: 500;
      line-height: 1;
    }

    .gg-hero__description {
      font-size: 20px;
      line-height: 1.4;
      max-width: 30.1875rem;
    }

    .gg-hero__button {
      font-size: 16px;
      line-height: 1.28;
    }

    .gg-hero__banner-text {
      font-size: 16px;
      line-height: 13.424px;
    }
  }
{% endstylesheet %}

{% javascript %}
  (function () {
    function initGiftGuideHeroHeader(header) {
      if (!header || header.dataset.menuInitialized === 'true') return;

      const toggle = header.querySelector('[data-menu-toggle]');
      const panel = header.querySelector('[data-mobile-menu]');
      if (!toggle || !panel) return;

      header.dataset.menuInitialized = 'true';

      const setMenuOpen = (open) => {
        header.classList.toggle('is-menu-open', open);
        toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
        toggle.querySelector('.gg-hero__menu-toggle-label').textContent = open ? 'Close menu' : 'Menu';
        panel.hidden = !open;
      };

      toggle.addEventListener('click', () => {
        setMenuOpen(!header.classList.contains('is-menu-open'));
      });

      panel.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', () => setMenuOpen(false));
      });

      window.matchMedia('(min-width: 750px)').addEventListener('change', (event) => {
        if (event.matches) setMenuOpen(false);
      });
    }

    function initAll(root) {
      (root || document).querySelectorAll('.gg-hero__header').forEach(initGiftGuideHeroHeader);
    }

    initAll();

    document.addEventListener('shopify:section:load', (event) => {
      initAll(event.target);
    });
  })();
{% endjavascript %}

